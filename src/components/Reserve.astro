---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<section class="section reserve" id="reserve">
	<div class="wrap">
		<div class="reserve__panel" data-reveal>
			<p class="sec-en">Reserve</p>
			<h2>ご予約・お問い合わせ</h2>
			<p class="reserve__lead">ご新規も、ご指名も。お電話、またはLINE公式アカウントで承ります。</p>
			<a class="reserve__tel" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
			<p class="reserve__hours">
				<span>{site.hoursWeekday}</span>
				<span>{site.hoursHoliday}</span>
				<span>定休日{site.closed}</span>
			</p>
			<div class="reserve__actions">
				<a class="btn btn--gold" href={`tel:${site.phoneTel}`}>
					<Icon name="phone" />
					電話する
				</a>
				<a class="btn btn--line" href={site.line} target="_blank" rel="noopener noreferrer">
					<Icon name="line" />
					LINE {site.lineHandle}
				</a>
				<a class="btn btn--line" href={site.instagram} target="_blank" rel="noopener noreferrer">
					<Icon name="instagram" />
					Instagram
				</a>
			</div>
			<p class="reserve__note">当日のキャンセルは、キャンセル料を申し受ける場合がございます。変更・取消はお早めにご連絡ください。</p>
		</div>
	</div>
</section>
