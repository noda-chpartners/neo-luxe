---
import { Image } from "astro:assets";
import promiseVisual from "../assets/images/line_oa_chat_261002_183621.jpg";
---

<section class="promise" aria-label="ブランドメッセージ">
	<figure class="promise__figure" data-reveal>
		<Image
			src={promiseVisual}
			alt="金色の光のなかに置かれた、LUXE 貴方だけの贅沢なひとときを、という言葉"
			widths={[640, 1100]}
			sizes="(min-width: 920px) 920px, 92vw"
			quality="high"
			layout="full-width"
		/>
	</figure>
</section>
