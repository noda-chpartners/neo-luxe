---
interface Props {
	href?: string;
}

const { href = "#top" } = Astro.props;
---

<a class="logo" href={href}>
	<svg class="logo__mark" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
		<rect x="1.2" y="1.2" width="33.6" height="33.6" rx="8"></rect>
		<path d="M10 26.2V10.2l8 16V10.2"></path>
		<path d="M21.2 10.2v16H28"></path>
	</svg>
	<span class="logo__name">NEO LUXE</span>
</a>
