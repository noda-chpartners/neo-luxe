---
import "../styles/global.scss";
import { site } from "../data/site";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "HealthAndBeautyBusiness",
	name: site.name,
	description: site.description,
	telephone: "+817085421016",
	image: "/ogp.jpg",
	address: {
		"@type": "PostalAddress",
		postalCode: "790-0878",
		addressCountry: "JP",
		addressRegion: "愛媛県",
		addressLocality: "松山市",
		streetAddress: "勝山町",
	},
	sameAs: [site.instagram, site.ekichika, site.estama],
};
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={site.description} />
		<meta name="theme-color" content="#fbf7f0" />
		<meta name="format-detection" content="telephone=no" />
		<title>NEO LUXE | 松山メンズエステ</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Shippori+Mincho:wght@500;600&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:title" content="NEO LUXE | 松山メンズエステ" />
		<meta property="og:description" content={site.description} />
		<meta property="og:image" content="/ogp.jpg" />
		<meta property="og:image:width" content="1000" />
		<meta property="og:image:height" content="500" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="NEO LUXE | 松山メンズエステ" />
		<meta name="twitter:description" content={site.description} />
		<meta name="twitter:image" content="/ogp.jpg" />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">本文へ</a>
		<div class="progress" data-progress aria-hidden="true"></div>
		<slot />
		<noscript>
			<style>
				[data-hero] {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
		<script>
			import "../scripts/main";
		</script>
	</body>
</html>
